# Render backend Web Service environment variables
# Add these keys in Render Dashboard > Backend Service > Environment.

# Runtime
APP_ENV=production
LLM_PROVIDER=gemini
REQUEST_TIMEOUT_SECONDS=60

# Supabase Cloud (backend only)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated

# Redis (configure either Redis or Upstash for deployment)
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Voice services
STT_PROVIDER=local_faster_whisper
TTS_PROVIDER=local_piper
VOICE_MAX_UPLOAD_MB=10
WHISPER_MODEL=base
PIPER_VOICE=ko_KR-kss-medium

# OpenAI (optional when Gemini is the selected provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
MAX_IMAGE_SIZE_MB=5

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
VISION_PROVIDER=gemini
GEMINI_VISION_MODEL=gemini-3.6-flash

# Kakao Local REST API (backend only)
KAKAO_REST_API_KEY=
KAKAO_LOCAL_BASE_URL=https://dapi.kakao.com
KAKAO_REQUEST_TIMEOUT_SECONDS=5
KAKAO_SEARCH_SIZE=10
KAKAO_MAX_RETRIES=1

# Ollama is for local development only. Render cannot reach 127.0.0.1 on your PC.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
