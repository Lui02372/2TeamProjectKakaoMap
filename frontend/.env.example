# Frontend environment variables. Copy to frontend/.env for local use,
# or add the same keys to Render Frontend Service > Environment.

# Public URL of the separately deployed FastAPI backend (no trailing slash)
BACKEND_API_URL=http://127.0.0.1:8000

# Kakao Maps JavaScript key. Restrict it to the frontend Render domain.
KAKAO_JAVASCRIPT_KEY=

REQUEST_TIMEOUT_SECONDS=60
