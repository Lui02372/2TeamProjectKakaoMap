# Render frontend Web Service environment variables
# Add these keys in Render Dashboard > Frontend Service > Environment.

# Public URL of the separately deployed FastAPI backend (no trailing slash)
BACKEND_API_URL=https://twoteamprojectkakaomap.onrender.com

# Kakao Maps JavaScript key. Restrict it to the frontend Render domain.
KAKAO_JAVASCRIPT_KEY=

REQUEST_TIMEOUT_SECONDS=60
