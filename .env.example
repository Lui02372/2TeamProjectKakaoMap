# Runtime
APP_ENV=development
LLM_PROVIDER=ollama
REQUEST_TIMEOUT_SECONDS=60

# Supabase Cloud (service role is backend-only; never commit values)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Do NOT paste either Dashboard > JWT Signing Keys or Legacy JWT Secret here.
# Supabase Auth issues user JWTs. The backend verifies them via the project's
# public JWKS endpoint derived automatically from SUPABASE_URL; only the service
# role key stays on the backend.
SUPABASE_JWT_AUDIENCE=authenticated

# Redis (use one provider; Upstash REST is preferred for Render deployments)
REDIS_URL=redis://127.0.0.1:6379/0
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local voice services (free defaults)
STT_PROVIDER=local_faster_whisper
TTS_PROVIDER=local_piper
VOICE_MAX_UPLOAD_MB=10
WHISPER_MODEL=base
PIPER_VOICE=ko_KR-kss-medium

# LLM providers (leave keys empty unless the provider is intentionally enabled)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
MAX_IMAGE_SIZE_MB=5
GEMINI_API_KEY=
GEMINI_MODEL=
# Gemini TTS is an optional free-tier preview fallback. Local Piper remains default.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
VISION_PROVIDER=gemini
GEMINI_VISION_MODEL=gemini-3.6-flash

# Local Ollama (Render cannot reach this local address)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Kakao (REST key is backend-only; JavaScript key is used by the map view)
KAKAO_REST_API_KEY=
KAKAO_JAVASCRIPT_KEY=
KAKAO_LOCAL_BASE_URL=https://dapi.kakao.com
KAKAO_REQUEST_TIMEOUT_SECONDS=5
KAKAO_SEARCH_SIZE=10
KAKAO_MAX_RETRIES=1

# Service-to-service URL (replace with the Render backend HTTPS URL in production)
BACKEND_API_URL=http://127.0.0.1:8000
